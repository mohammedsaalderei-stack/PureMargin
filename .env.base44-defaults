# Local dev defaults — overridden by /run/base44/app.env (platform secrets).
# Signs session tokens and encrypts stored POS tokens. Local-only value is
# fine for development; the real one would come from the user.
SESSION_SECRET=sufra-dev-secret-change-me

# Opens the admin panel at #/admin. Must match the email of an account that
# has already registered. Left empty, the panel refuses everyone — including
# you — because the bootstrap admin is the only way in.
ADMIN_EMAIL=
