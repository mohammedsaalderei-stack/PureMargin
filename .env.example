# Required for the assistant.
ANTHROPIC_API_KEY=sk-ant-...

# --- Accounts and saved conversations ---
# These hold registered accounts, their encrypted till tokens, and chat
# threads. Install a Redis integration from the Vercel Marketplace:
# Storage -> Browse Marketplace -> Redis.
#
# Either provider works; the app detects which one is attached.
#
#   Redis Cloud, and most others -> sets REDIS_URL. Uses the `redis`
#   package, already in dependencies. Nothing else to do.
#
#   Upstash -> sets KV_REST_API_URL and KV_REST_API_TOKEN. Speaks HTTP,
#   so it needs no package and holds no connection open. Slightly better
#   suited to serverless under bursty traffic.
#
# NOT a Global Config / Edge Config store. That is read-optimised
# configuration storage, capped at 1 MB, and cannot be written from a
# function at all.
#
# With none of these set, accounts and threads are held in memory and vanish
# on the next cold start. The register page warns the person before they
# rely on it.
REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Signs session tokens and encrypts stored POS tokens.
# Set a long random string. Changing it signs everyone out and makes
# already-stored POS tokens unreadable, so pick one and keep it.
#
# There is no shared-password mode. Sign-in requires a registered account
# with a matching password hash, and nothing else opens the door.
SESSION_SECRET=

# Who can open the admin panel at #/admin.
#
# This is the bootstrap admin, and it is the ONLY way in: further admins are
# granted from inside the panel, so with this unset nobody can reach it at all
# and every sign-in there fails with the same "credentials" message a wrong
# password gives.
#
# It must match the email of an account that has already registered through
# the normal sign-up flow. Case and surrounding spaces don't matter.
ADMIN_EMAIL=

# The address invitation links point at, e.g. https://puremargin.ae
#
# Team invitations are emailed with a link built from this. Unset, the link is
# built from the request headers instead, so an invitation sent while the
# inviter is on a preview build or the project's *.vercel.app address carries
# that host into the recipient's inbox — and a preview URL stops resolving once
# that deployment is rotated away. Set this to your canonical domain.
APP_URL=https://puremargin.ae

# --- Outgoing mail ---
# Password reset codes and feedback tickets go out through Resend. With no key
# set, mail is not sent: the message is logged to the server console instead,
# so the reset code is readable in `docker compose logs api` during local
# development.
RESEND_API_KEY=

# The sender address. Must be exactly `email@example.com` or
# `Name <email@example.com>` — Resend rejects the entire send with a 422
# otherwise, and anything that isn't one of those two shapes is ignored here in
# favour of Resend's shared sender.
#
# The domain has to be verified at resend.com/domains. Note that the dashboard
# writes the suggested sender with a placeholder local part, like
# `<anything>@yourdomain.resend.app` — the angle brackets are an instruction to
# choose a mailbox name, not part of the address. Copying that line verbatim is
# what a 422 on the `from` field usually means.
#
# Unset, mail goes out from Resend's shared `onboarding@resend.dev`, which can
# only deliver to the address that owns the Resend account. Fine for a first
# smoke test, useless in production.
MAIL_FROM=PureMargin <noreply@puremargin.ae>

# Where replies to outgoing mail land. Defaults to the support address.
MAIL_REPLY_TO=

# Where "not helpful" reports and support tickets are emailed.
# Defaults to the support address.
FEEDBACK_EMAIL_TO=

# --- Optional ---
# A single till for the whole deployment. With this set, accounts don't
# need to connect their own and the first-run prompt is skipped.
LOYVERSE_ACCESS_TOKEN=

# A Loyverse-compatible POS other than Loyverse itself. POS_ACCESS_TOKEN is
# read in preference to LOYVERSE_ACCESS_TOKEN; POS_API_BASE defaults to
# https://api.loyverse.com/v1.0
POS_ACCESS_TOKEN=
POS_API_BASE=

# Where "not helpful" reports and support tickets are delivered.
FEEDBACK_WEBHOOK_URL=
