{
  "name": "sufra",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run check && node scripts/test.mjs",
    "check": "node scripts/check-imports.mjs && node scripts/check-cycles.mjs && node scripts/check-scroll.mjs && node scripts/check-i18n.mjs && node scripts/check-tabs.mjs && node scripts/check-api-urls.mjs",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --status",
    "ledger:verify": "node scripts/ledger.mjs verify",
    "ledger:backfill": "node scripts/ledger.mjs backfill",
    "backup": "node scripts/backup.mjs dump",
    "backup:verify": "node scripts/backup.mjs verify",
    "backup:restore": "node scripts/backup.mjs restore",
    "icons": "node scripts/icons.mjs",
    "ios": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/camera": "^6.1.2",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/network": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "lucide-react": "^0.454.0",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.23.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "redis": "^4.7.0",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "puppeteer": "^22.15.0"
  }
}
