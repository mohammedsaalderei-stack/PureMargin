<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>PureMargin</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- The five languages the app already speaks. Declaring them is what
	     makes the App Store listing show as localised, and what makes iOS
	     hand the web view the right preferred language on first launch. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ar</string>
		<string>hi</string>
		<string>ur</string>
		<string>tl</string>
	</array>

	<!-- ====================================================================
	     Permission strings.

	     iOS terminates an app immediately, with no error and no crash log a
	     user would recognise, if it reaches for the camera without one of
	     these. The app does not crash so much as vanish, which is why this
	     is the first thing to get wrong and the hardest to diagnose.

	     Apple reads the wording. "Needs camera access" is rejected as
	     unhelpful; a sentence saying what the person gets is not.
	     ==================================================================== -->
	<key>NSCameraUsageDescription</key>
	<string>PureMargin uses the camera so staff can photograph the workplace when they clock in and out, and so you can scan a supplier invoice instead of typing it in.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>PureMargin lets you choose a photograph of a supplier invoice you have already taken, so its lines can be read and added to your stock.</string>

	<!-- The register's printers. Receipt and kitchen printers sit on the
	     shop's own network, and iOS asks before an app reaches anything on
	     it; the wording is what the cashier reads in that prompt. The
	     Bonjour type is the one receipt printers announce themselves under,
	     so they can be picked from a list rather than typed in by address.

	     Local networking is also what lets a test build reach a server on
	     the same Wi-Fi by its address. It allows nothing on the internet. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>PureMargin connects to Bluetooth receipt printers so the register can print receipts and kitchen orders.</string>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.epson.escpos</string>
		<string>jp.star-m.starpro</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>PureMargin connects to the receipt printers, kitchen printers and cash drawer on your shop's network so the register can print and open the drawer.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_pdl-datastream._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Export compliance. The app uses HTTPS and nothing else, which is
	     exempt; declaring it here means App Store Connect stops asking the
	     same question on every single upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- The scene life cycle. Built against the iOS 27 SDK, an app without
	     this is refused at launch: it opens to a black screen and closes,
	     and the only trace is "UIScene life cycle is required for app" in
	     the device log. One window, loaded from Main as before; see
	     SceneDelegate.swift. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>

	<!-- Portrait only on iPhone. Every screen here is a column of figures
	     read one-handed next to a pass; landscape gains nothing and gives
	     the keyboard most of the display. iPad keeps all four, because a
	     tablet on a stand is usually in landscape. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
