{
  "appId": "ae.puremargin.app",
  "appName": "PureMargin",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#08060E",
    "limitsNavigationsToAppBoundDomains": false,
    "scrollEnabled": true,
    "preferredContentMode": "mobile"
  },
  "android": {
    "backgroundColor": "#08060E"
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "allowNavigation": ["puremargin.ae", "*.puremargin.ae"]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 500,
      "launchAutoHide": false,
      "backgroundColor": "#08060E",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#08060E",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "native",
      "style": "DARK",
      "resizeOnFullScreen": true
    }
  }
}
